{$DOMAIN} {
    encode zstd gzip

    reverse_proxy api:8000 {
        # Flush streamed chat and research events immediately.
        flush_interval -1
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format json
    }
}
