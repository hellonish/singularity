# Copy to .env.production on the EC2 host and replace every placeholder.
# Never commit .env.production. Deploy Compose with --env-file .env.production.

# Release and public API endpoint
API_IMAGE=singularity/singularity-api:latest
DOMAIN=api.example.com
ENVIRONMENT=production

# Supabase Postgres. Use postgresql+asyncpg and require TLS.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?ssl=require

# Supabase Storage S3-compatible API (private report bucket)
SINGULARITY_STORAGE_BACKEND=s3
SINGULARITY_S3_BUCKET=singularity-reports
SINGULARITY_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SINGULARITY_S3_REGION=SUPABASE_PROJECT_REGION
SINGULARITY_S3_ACCESS_KEY_ID=replace-me
SINGULARITY_S3_SECRET_ACCESS_KEY=replace-me

# Authentication and browser boundary
SINGULARITY_AUTH_MODE=bearer
SINGULARITY_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
SINGULARITY_JWT_SECRET=replace-with-a-long-random-secret
SINGULARITY_CREDENTIAL_ENCRYPTION_KEY=replace-with-stable-fernet-key
SINGULARITY_CORS_ALLOW_ORIGINS=https://app.example.com

# Research worker and logging
SINGULARITY_RESEARCH_WORKER_ENABLED=true
SINGULARITY_RESEARCH_TEST_MODE=false
SINGULARITY_LOG_MODE=steps
SINGULARITY_LOG_LEVEL=INFO

# Modal tool execution
SINGULARITY_MODAL_ENABLED=1
SINGULARITY_MODAL_APP=singularity-chat-tools
SINGULARITY_MODAL_FUNCTION=execute_chat_tool
SINGULARITY_MODAL_ENVIRONMENT=main
SINGULARITY_MODAL_TOOL_SECRET=singularity-tool-providers
MODAL_TOKEN_ID=replace-me
MODAL_TOKEN_SECRET=replace-me

# Qdrant Cloud
QDRANT_URL=https://replace-me.cloud.qdrant.io
QDRANT_API_KEY=replace-me

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=singularity-prod
SINGULARITY_LANGSMITH_CAPTURE_CONTENT=false
