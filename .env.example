# Copy this file to .env for local development or .env.production for deployment.
# Neither secret file is committed.

# Core services
DATABASE_URL=postgresql+asyncpg://singularity:change-me@localhost:5432/singularity
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Vector store
QDRANT_LOCATION=http://localhost:6333
QDRANT_API_KEY=

# Optional retrieval integrations
GITHUB_TOKEN=
GOOGLE_BOOKS_API_KEY=
IEEE_API_KEY=
NCBI_EMAIL=
TAVILY_API_KEY=

# OAuth and production image naming
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET=
LLM_CREDENTIALS_ENCRYPTION_KEY=
DOCKERHUB_USER=
DOMAIN=
POSTGRES_USER=singularity
POSTGRES_PASSWORD=
